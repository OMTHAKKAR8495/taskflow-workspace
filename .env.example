# Frontend API URL (leave /api for same-origin proxy on Vercel or http://localhost:4000/api for local dev)
VITE_API_URL=/api

# Public Application Base URL (used by backend to construct absolute invitation links)
APP_BASE_URL=https://taskflow-workspace-seven.vercel.app

# Google Client ID for frontend Google Identity Services
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
