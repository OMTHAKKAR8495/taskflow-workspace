PORT=4000
NODE_ENV=production

# Hosted PostgreSQL connection string (Supabase IPv4 Supavisor Pooler or Neon)
# Note: Direct Supabase hosts (db.*.supabase.co:5432) are IPv6-only and will fail on Vercel.
# Always use the IPv4 Supavisor pooler host (e.g., aws-0-[region].pooler.supabase.com:5432):
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR_PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Public Application Base URL used to construct single-use invitation acceptance links
APP_BASE_URL=https://taskflow-workspace-seven.vercel.app

# Email Provider Configuration (Optional)
# If unconfigured, the system gracefully generates secure cryptographic share links that can be copied directly.
# Option A: Resend (Recommended)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="TaskFlow Nexus <invitations@taskflow.dev>"

# Option B: Standard SMTP (e.g., SendGrid, Mailgun, AWS SES, Gmail)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your-smtp-secret-password
# SMTP_FROM="TaskFlow Team <no-reply@taskflow.dev>"

# JWT secret for authentication cookies
JWT_SECRET=super-secret-jwt-token-key-change-in-production
